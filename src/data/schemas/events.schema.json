{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GDGoC LDCE Events Data",
  "description": "Schema for events.json file - defines the structure for all community events",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "description": "Array of all events to display",
      "items": {
        "$ref": "#/definitions/Event"
      }
    }
  },
  "definitions": {
    "Event": {
      "type": "object",
      "description": "A single event entry",
      "required": [
        "id",
        "title",
        "eventType",
        "description",
        "date",
        "details",
        "highlights",
        "color"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the event. Use lowercase with hyphens (kebab-case)",
          "pattern": "^[a-z0-9-]+$",
          "examples": ["orientation-2025", "cloud-study-jam-2025"]
        },
        "title": {
          "type": "string",
          "description": "Display title of the event",
          "examples": ["GDGoC LDCE Orientation - 2025"]
        },
        "eventType": {
          "type": "string",
          "description": "Type/category of the event",
          "examples": [
            "Community Kickoff / Introduction Session",
            "Hands-on Cloud Learning Program"
          ]
        },
        "description": {
          "type": "string",
          "description": "Full description of the event. Can be multiple sentences."
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "ISO date string (YYYY-MM-DD). For multi-day events, use the start date.",
          "examples": ["2025-09-11", "2025-10-20"]
        },
        "details": {
          "type": "array",
          "description": "Array of detail items to show on the card",
          "items": {
            "$ref": "#/definitions/EventDetail"
          }
        },
        "highlights": {
          "type": "array",
          "description": "Key highlights/achievements from the event",
          "items": {
            "$ref": "#/definitions/EventHighlight"
          }
        },
        "color": {
          "type": "string",
          "enum": ["blue", "red", "green", "yellow"],
          "description": "Color theme for the event card. Choose from Google brand colors."
        },
        "order": {
          "type": "number",
          "description": "Display order (lower numbers appear first). If not specified, events are sorted by date."
        },
        "isVisible": {
          "type": "boolean",
          "default": true,
          "description": "Set to false to hide an event without deleting it"
        },
        "studyJamData": {
          "$ref": "#/definitions/StudyJamData",
          "description": "Optional: Extra content for Study Jam type events"
        }
      }
    },
    "EventDetail": {
      "type": "object",
      "description": "A single detail item shown on the event card",
      "required": ["label", "value"],
      "properties": {
        "label": {
          "type": "string",
          "description": "The label/title for this detail",
          "examples": ["Date", "Venue", "Mode", "Attendance", "Duration"]
        },
        "value": {
          "type": "string",
          "description": "The value of this detail",
          "examples": ["11 September 2025", "Vishwakarma Hall, LDCE", "Online"]
        }
      }
    },
    "EventHighlight": {
      "type": "object",
      "description": "A highlight point for the event",
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "description": "The highlight text to display",
          "examples": ["200+ participants", "Achieved Tier 1 status"]
        }
      }
    },
    "StudyJamData": {
      "type": "object",
      "description": "Extra content for Study Jam type events",
      "required": ["houseMentors", "winners", "syllabus"],
      "properties": {
        "houseMentors": {
          "type": "array",
          "description": "List of house mentors",
          "items": {
            "$ref": "#/definitions/HouseMentor"
          }
        },
        "winners": {
          "type": "array",
          "description": "List of winners",
          "items": {
            "$ref": "#/definitions/Winner"
          }
        },
        "syllabus": {
          "type": "array",
          "description": "Syllabus/topics covered in the program",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "HouseMentor": {
      "type": "object",
      "description": "House mentor information",
      "required": ["house", "mentor"],
      "properties": {
        "house": {
          "type": "string",
          "description": "Name of the house",
          "examples": ["Alpha", "Bravo", "Charlie"]
        },
        "mentor": {
          "type": "string",
          "description": "Name of the mentor leading this house"
        }
      }
    },
    "Winner": {
      "type": "object",
      "description": "Winner information for competitive events",
      "required": ["position", "name", "emoji"],
      "properties": {
        "position": {
          "type": "string",
          "description": "Position (1st, 2nd, 3rd, etc.)",
          "examples": ["1st", "2nd", "3rd"]
        },
        "name": {
          "type": "string",
          "description": "Name of the winner/team"
        },
        "emoji": {
          "type": "string",
          "description": "Emoji to display",
          "examples": ["🥇", "🥈", "🥉"]
        }
      }
    }
  }
}
