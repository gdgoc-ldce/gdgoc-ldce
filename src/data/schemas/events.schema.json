{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GDGoC LDCE Events Data",
  "description": "Schema for events.json file - defines the structure for all community events",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "description": "Array of all events to display",
      "items": {
        "$ref": "#/definitions/Event"
      }
    }
  },
  "definitions": {
    "Event": {
      "type": "object",
      "description": "A single event entry",
      "required": [
        "id",
        "title",
        "eventType",
        "description",
        "date",
        "details",
        "highlights",
        "color"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": { "type": "string" },
        "eventType": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "details": {
          "type": "array",
          "items": { "$ref": "#/definitions/EventDetail" }
        },
        "highlights": {
          "type": "array",
          "items": { "$ref": "#/definitions/EventHighlight" }
        },
        "images": {
          "type": "array",
          "description": "Gallery images for the event",
          "items": { "$ref": "#/definitions/EventImage" }
        },
        "color": {
          "type": "string",
          "enum": ["blue", "red", "green", "yellow"]
        },
        "order": { "type": "number" },
        "isVisible": { "type": "boolean", "default": true },
        "studyJamData": {
          "$ref": "#/definitions/StudyJamData",
          "description": "Optional: Extra content for Study Jam type events"
        },
        "hackathonData": {
          "$ref": "#/definitions/HackathonData",
          "description": "Optional: Extra content for Hackathon type events"
        }
      }
    },
    "EventDetail": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "EventHighlight": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" }
      }
    },
    "EventImage": {
      "type": "object",
      "required": ["src", "alt"],
      "properties": {
        "src": { "type": "string" },
        "alt": { "type": "string" },
        "caption": { "type": "string" }
      }
    },
    "HackathonData": {
      "type": "object",
      "required": [
        "preMentoringSessions",
        "evaluationCriteria",
        "winningTeams"
      ],
      "properties": {
        "preMentoringSessions": {
          "type": "array",
          "items": { "$ref": "#/definitions/MentoringSession" }
        },
        "evaluationCriteria": {
          "type": "array",
          "items": { "type": "string" }
        },
        "winningTeams": {
          "type": "array",
          "items": { "$ref": "#/definitions/WinningTeam" }
        }
      }
    },
    "MentoringSession": {
      "type": "object",
      "required": ["title", "speaker", "description"],
      "properties": {
        "title": { "type": "string" },
        "speaker": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "WinningTeam": {
      "type": "object",
      "required": ["rank", "teamName", "lead", "members"],
      "properties": {
        "rank": { "type": "string" },
        "teamName": { "type": "string" },
        "lead": { "type": "string" },
        "members": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "StudyJamData": {
      "type": "object",
      "required": ["houseMentors", "winners", "syllabus"],
      "properties": {
        "houseMentors": {
          "type": "array",
          "items": { "$ref": "#/definitions/HouseMentor" }
        },
        "winners": {
          "type": "array",
          "items": { "$ref": "#/definitions/Winner" }
        },
        "syllabus": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "HouseMentor": {
      "type": "object",
      "required": ["house", "mentor"],
      "properties": {
        "house": { "type": "string" },
        "mentor": { "type": "string" }
      }
    },
    "Winner": {
      "type": "object",
      "required": ["position", "name", "emoji"],
      "properties": {
        "position": { "type": "string" },
        "name": { "type": "string" },
        "emoji": { "type": "string" }
      }
    }
  }
}
